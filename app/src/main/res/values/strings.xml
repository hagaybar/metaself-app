        <item quantity="one">Delete this one</item>
        <item quantity="other">Delete these %1$d</item>
    </plurals>
    <!-- Only the app's own word "portion" is drawn through this — on the day, a meal's parts, the adjuster, and the model's proposal; any other unit is shown exactly as it was written (D37). -->
