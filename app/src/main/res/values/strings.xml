        <item quantity="one">%1$d thing</item>
        <item quantity="other">%1$d things</item>
    </plurals>
    <!--
      Deleting everything that is ticked, in one go (#50). Its own words rather than the row's plain
      "Delete", so a screen reader is not read two different controls under one name (#12), and so
      that the count he is about to lose is on the button that loses it.
    -->
