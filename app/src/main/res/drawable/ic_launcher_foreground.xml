<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: a bowl with a level in it.

  It replaces the placeholder "M" from step 1. A bowl because that is what this app is about, and a
  level line because what it actually does is tell you where you are against a number.

  Drawn inside the 108dp adaptive-icon canvas with everything kept within the middle 72dp safe zone,
  so it survives Android's circular, squircle and rounded-square masks without being clipped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The bowl: a half-round with a foot, centred in the safe zone. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30,50 L78,50 A24,24 0 0 1 30,50 Z" />

    <!-- What is in it: the level, sitting a third up the bowl. -->
    <path
        android:fillColor="#FF7FD1A8"
        android:pathData="M34,58 L74,58 A20,20 0 0 1 34,58 Z" />

    <!-- The rim, so the bowl reads as a bowl and not a semicircle. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,46 L82,46 L82,51 L26,51 Z" />

    <!-- The foot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,74 L60,74 L60,80 L48,80 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,80 L68,80 L68,85 L40,85 Z" />
</vector>
